#!/usr/bin/env python3
"""Download pending scanner images into isolated Compose overrides; never deploy."""

import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request

STATE_DIR = Path("/var/lib/scanner-update")
STACK = Path("/root/unonwhash/docker-compose.yml")
RECOVERY_OVERRIDE = STACK.parent / "scanner-updates.staged.json"
SERVICES = {
    name: (STACK, name, "stage")
    for name in (
        "dragonite",
        "admin",
        "golbat",
        "rotom-ng",
        "poracle",
        "lork",
        "koji",
        "fletchling",
        "grafana",
    )
}
SERVICES.update(
    {
        "db": (STACK, "db", "stage"),
        "diadem-db": (Path("/opt/diadem/docker-compose.yml"), "diadem-db", "stage"),
        "tileserver-cache": (
            Path("/root/tileserver/docker-compose.yml"),
            "rampardos",
            "report",
        ),
    }
)
ACCEPT = ", ".join(
    (
        "application/vnd.oci.image.index.v1+json",
        "application/vnd.docker.distribution.manifest.list.v2+json",
        "application/vnd.oci.image.manifest.v1+json",
        "application/vnd.docker.distribution.manifest.v2+json",
    )
)


def log(message):
    print(
        f"[{datetime.datetime.now(datetime.timezone.utc).isoformat()}] {message}",
        flush=True,
    )


def run(args, cwd=None, timeout=60):
    # Hard guard: the only Docker writes this program can perform are pulling
    # immutable references and tagging copies. No deploy/restart entry point.
    allowed = (
        args[:2] in (["docker", "inspect"], ["docker", "pull"])
        or args[:3] in (["docker", "image", "inspect"], ["docker", "image", "tag"])
        or (
            args[:3] == ["docker", "compose", "-f"]
            and "config" in args
            and not any(x in args for x in ("up", "down", "restart", "start", "stop"))
        )
        or args[:2] == ["/usr/bin/python3", "/root/Poliswag/scripts/dm_owner.py"]
    )
    if not allowed:
        raise ValueError(f"Command outside staging policy: {args[:3]}")
    env = dict(os.environ)
    if cwd:
        env["PWD"] = str(cwd)
    result = subprocess.run(
        args,
        cwd=cwd,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
    )
    if result.returncode:
        # Do not dump rendered Compose configuration or credentials into logs/DMs.
        raise RuntimeError(
            f'O comando `{" ".join(args[:3])}` falhou (código {result.returncode}).'
        )
    return result.stdout


def compose(path, *args):
    return run(["docker", "compose", "-f", str(path), *args], cwd=path.parent)


def inspect_container(name):
    return json.loads(run(["docker", "inspect", name]))[0]


def inspect_image(reference):
    return json.loads(run(["docker", "image", "inspect", reference]))[0]


class Registry:
    def __init__(self, reference):
        self.original = reference
        unpinned = reference.split("@", 1)[0]
        parts = unpinned.split("/")
        if len(parts) > 1 and (
            "." in parts[0] or ":" in parts[0] or parts[0] == "localhost"
        ):
            self.host = parts.pop(0)
        else:
            self.host = "docker.io"
        if self.host == "docker.io" and len(parts) == 1:
            parts.insert(0, "library")
        self.repo = "/".join(parts)
        last = self.repo.rsplit("/", 1)[-1]
        if ":" in last:
            self.repo, self.tag = self.repo.rsplit(":", 1)
        else:
            self.tag = "latest"
        # A tileserver digest is checked against latest; its live pin is untouched.
        self.prefix = unpinned.rsplit(":", 1)[0] if ":" in last else unpinned
        self.base = "https://" + (
            "registry-1.docker.io" if self.host == "docker.io" else self.host
        )
        auth_base, service = (
            ("https://auth.docker.io/token", "registry.docker.io")
            if self.host == "docker.io"
            else (f"https://{self.host}/token", self.host)
        )
        query = urllib.parse.urlencode(
            {"service": service, "scope": f"repository:{self.repo}:pull"}
        )
        with urllib.request.urlopen(auth_base + "?" + query, timeout=30) as response:
            token = json.load(response)
        self.headers = {
            "Authorization": "Bearer " + (token.get("token") or token["access_token"]),
            "Accept": ACCEPT,
            "User-Agent": "scanner-update/1.0",
        }

    def get(self, url):
        request = urllib.request.Request(url, headers=self.headers)
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
            digest = response.headers.get("Docker-Content-Digest")
            return (
                json.loads(raw),
                digest or "sha256:" + hashlib.sha256(raw).hexdigest(),
                response.headers.get("Link", ""),
            )

    def newest_testing(self):
        url = f"{self.base}/v2/{self.repo}/tags/list?n=1000"
        versions = []
        while url:
            data, _, link = self.get(url)
            for tag in data.get("tags", []):
                match = re.fullmatch(r"dragonite-v(\d+)\.(\d+)\.(\d+)-testing", tag)
                if match:
                    versions.append((tuple(map(int, match.groups())), tag))
            match = re.search(r'<([^>]+)>;\s*rel="next"', link)
            url = urllib.parse.urljoin(self.base, match[1]) if match else None
            if (
                url
                and urllib.parse.urlparse(url).netloc
                != urllib.parse.urlparse(self.base).netloc
            ):
                raise RuntimeError(
                    "O registo de imagens encaminhou a consulta para outro servidor."
                )
        if not versions:
            raise RuntimeError("Não foram encontradas versões de teste do Dragonite.")
        latest = max(versions)
        current = re.fullmatch(r"dragonite-v(\d+)\.(\d+)\.(\d+)-testing", self.tag)
        if not current:
            raise RuntimeError(
                "O Dragonite não está configurado para uma versão de teste. A versão atual foi mantida."
            )
        # Never downgrade an existing Compose version.
        return self.tag if tuple(map(int, current.groups())) > latest[0] else latest[1]

    def candidate(self, tag, architecture, os_name, variant=""):
        manifest, root_digest, _ = self.get(
            f"{self.base}/v2/{self.repo}/manifests/{tag}"
        )
        digests = {root_digest}
        while "manifests" in manifest:
            matches = [
                m
                for m in manifest["manifests"]
                if m.get("platform", {}).get("architecture") == architecture
                and m.get("platform", {}).get("os") == os_name
                and (not variant or m.get("platform", {}).get("variant") == variant)
            ]
            if not matches:
                raise RuntimeError(
                    f"Não existe uma imagem para {os_name}/{architecture}."
                )
            child = matches[0]["digest"]
            digests.add(child)
            manifest, _, _ = self.get(f"{self.base}/v2/{self.repo}/manifests/{child}")
        digests.add(manifest["config"]["digest"])
        return root_digest, digests


def atomic_json(path, data):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
        temporary = Path(handle.name)
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def save_overrides(records):
    overrides = {}
    for record in records.values():
        if record.get("downloaded"):
            overrides.setdefault(record["compose"], {})[record["service"]] = {
                "image": record["candidate"]
            }
    for path in {str(item[0]) for item in SERVICES.values()}:
        live = Path(path)
        target = STATE_DIR / (live.parent.name + ".staged.json")
        content = {"services": overrides.get(path, {})}
        # Validate the combined Compose model without printing secrets or starting anything.
        with tempfile.NamedTemporaryFile(
            mode="w", dir=STATE_DIR, suffix=".json"
        ) as handle:
            json.dump(content, handle)
            handle.flush()
            compose(live, "-f", handle.name, "config", "--quiet")
        atomic_json(target, content)
    # Already mounted read-only in Poliswag; only the four session-related
    # services are eligible here. Recovery still explicitly selects its services.
    recovery = {
        k: v
        for k, v in overrides.get(str(STACK), {}).items()
        if k in ("dragonite", "admin", "golbat", "rotom-ng")
    }
    atomic_json(RECOVERY_OVERRIDE, {"services": recovery})


def fingerprint(container):
    return (
        container["Id"],
        container["Image"],
        container["State"]["StartedAt"],
        container["RestartCount"],
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check",
        action="store_true",
        help="Read-only registry check; no downloads, files, or DMs",
    )
    parser.add_argument(
        "--status",
        action="store_true",
        help="Show the saved report without querying registries",
    )
    parser.add_argument(
        "--notify",
        action="store_true",
        help="DM an embed when pending updates or errors change",
    )
    parser.add_argument(
        "--services",
        nargs="+",
        choices=SERVICES,
        help="Limit this run to specific containers",
    )
    args = parser.parse_args()
    if args.check and args.notify:
        parser.error("--check cannot be combined with --notify")
    with contextlib.ExitStack() as resources:
        return check_and_stage(args, resources)


def check_and_stage(args, resources):
    state_path = STATE_DIR / "state.json"
    state = (
        json.loads(state_path.read_text()) if state_path.exists() else {"services": {}}
    )
    if args.status:
        print(json.dumps(state, indent=2, sort_keys=True))
        return 0
    lock = None
    if not args.check:
        STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        lock = resources.enter_context(open(STATE_DIR / "lock", "a"))
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("Another scanner-update run is active; skipping")
            return 0
        # Read again under the lock.
        if state_path.exists():
            state = json.loads(state_path.read_text())
    records = state["services"]
    configs = {}
    errors = []
    for name in args.services or SERVICES:
        path, service, policy = SERVICES[name]
        try:
            before = inspect_container(name)
            image = inspect_image(before["Image"])
            if str(path) not in configs:
                configs[str(path)] = json.loads(
                    compose(path, "config", "--format", "json")
                )
            reference = configs[str(path)]["services"][service]["image"]
            registry = Registry(reference)
            tag = registry.newest_testing() if name == "dragonite" else registry.tag
            digest, remote_digests = registry.candidate(
                tag, image["Architecture"], image["Os"], image.get("Variant", "")
            )
            local_digests = {before["Image"], image["Id"]}
            local_digests.update(
                value.split("@", 1)[1]
                for value in image.get("RepoDigests", [])
                if "@" in value
            )
            pending = not bool(local_digests & remote_digests)
            candidate = f"{registry.prefix}:{tag}@{digest}"
            record = {
                "compose": str(path),
                "service": service,
                "policy": policy,
                "running": before["Config"]["Image"],
                "running_image": before["Image"],
                "candidate": candidate,
                "version": tag,
                "digest": digest,
                "pending": pending,
                "downloaded": False,
            }
            previous = records.get(name, {})
            # Retain applied pins: removing the override after recovery would
            # make the next recovery fall back to the old live Compose version.
            if policy == "stage" and (
                (previous.get("candidate") == candidate and previous.get("downloaded"))
                or before["Config"]["Image"] == candidate
            ):
                record["downloaded"] = True
            if pending and policy == "stage" and not args.check:
                if shutil.disk_usage(STATE_DIR).free < 3 * 1024**3:
                    raise RuntimeError(
                        "Há menos de 3 GiB livres em disco. A transferência foi adiada."
                    )
                # Digest pulls do not move :main/:latest (used by automatic recovery).
                run(["docker", "pull", candidate], timeout=900)
                run(
                    [
                        "docker",
                        "image",
                        "tag",
                        candidate,
                        f"scanner-staged/{name}:{digest[7:19]}",
                    ]
                )
                run(
                    [
                        "docker",
                        "image",
                        "tag",
                        before["Image"],
                        f'scanner-previous/{name}:{before["Image"][7:19]}',
                    ]
                )
                record["downloaded"] = True
            after = inspect_container(name)
            if fingerprint(before) != fingerprint(after):
                raise RuntimeError(
                    "O serviço foi alterado durante a verificação. Será verificado novamente na próxima execução."
                )
            records[name] = record
            result = (
                "current"
                if not pending
                else (
                    "downloaded; waiting for you"
                    if record["downloaded"]
                    else "update available"
                )
            )
            log(f"{name}: {tag}; {result}")
        except Exception as error:
            errors.append(f"{name}: {error}")
            log(f"ERROR {errors[-1]}")
    state["checked_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat()
    state["errors"] = errors
    if args.check:
        return 1 if errors else 0
    save_overrides(records)
    atomic_json(state_path, state)
    pending_records = {k: v for k, v in records.items() if v.get("pending")}
    notification = {
        "updates": {
            k: (v["candidate"], v["downloaded"]) for k, v in pending_records.items()
        },
        "errors": errors,
    }
    signature = hashlib.sha256(
        json.dumps(notification, sort_keys=True).encode()
    ).hexdigest()
    if (
        args.notify
        and (pending_records or errors)
        and signature != state.get("notified_signature")
    ):
        lines = [
            "Foram encontradas atualizações. Os serviços continuam a funcionar com as versões atuais.",
            "",
        ]
        for name, record in pending_records.items():
            status = (
                (
                    "pronta a instalar quando o servidor for desligado ou reiniciado"
                    if name in ("db", "diadem-db")
                    else "descarregada; aguarda instalação"
                )
                if record["downloaded"]
                else "disponível; instalação manual"
            )
            lines.append(
                f'• **{name}** — {record["version"]} (`{record["digest"][7:19]}`): {status}.'
            )
        if errors:
            lines += [
                "",
                "**Não foi possível concluir estas verificações:**",
                *["• " + error for error in errors],
            ]
        lines += [
            "",
            "Consultar o estado: `scanner-update --status`.",
        ]
        try:
            run(
                [
                    "/usr/bin/python3",
                    "/root/Poliswag/scripts/dm_owner.py",
                    "\n".join(lines),
                    (
                        "⚠️ Falha na verificação de atualizações"
                        if errors
                        else "📦 Atualizações prontas a instalar"
                    ),
                ]
            )
            state["notified_signature"] = signature
            atomic_json(state_path, state)
        except Exception as error:
            log(f"Owner notification failed: {error}; will retry next run")
            return 1
    elif not pending_records and not errors:
        state.pop("notified_signature", None)
        atomic_json(state_path, state)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
