#!/usr/bin/env python3
"""Apply downloaded database patch images during an orderly host shutdown."""

import argparse
import datetime
import fcntl
import gzip
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

STATE_DIR = Path("/var/lib/scanner-update")
BACKUP_DIR = Path("/root/backups/scanner-database-updates")
DATABASES = {
    "db": (Path("/root/unonwhash/docker-compose.yml"), "10.11"),
    "diadem-db": (Path("/opt/diadem/docker-compose.yml"), "11.4"),
}
DM = "/root/Poliswag/scripts/dm_owner.py"


def log(message):
    print(message, flush=True)


def run(command, *, cwd=None, timeout=30, output=None):
    env = dict(os.environ)
    if cwd:
        env["PWD"] = str(cwd)
    result = subprocess.run(
        command,
        cwd=cwd,
        env=env,
        stdout=output if output is not None else subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=output is None,
        timeout=timeout,
    )
    if result.returncode:
        raise RuntimeError(
            f"O comando `{' '.join(command[:3])}` falhou (código {result.returncode})."
        )
    return result.stdout


def shutting_down():
    jobs = run(["systemctl", "list-jobs", "--no-pager", "--no-legend"])
    targets = {
        "shutdown.target",
        "reboot.target",
        "poweroff.target",
        "halt.target",
        "kexec.target",
        "exit.target",
    }
    return any(
        len(row.split()) >= 3
        and row.split()[1] in targets
        and row.split()[2] == "start"
        for row in jobs.splitlines()
    )


def inspect(name, image=False):
    command = (
        ["docker", "image", "inspect", name] if image else ["docker", "inspect", name]
    )
    return json.loads(run(command))[0]


def atomic_state(state):
    with tempfile.NamedTemporaryFile(mode="w", dir=STATE_DIR, delete=False) as file:
        json.dump(state, file, indent=2, sort_keys=True)
        file.write("\n")
        temporary = Path(file.name)
    temporary.chmod(0o600)
    os.replace(temporary, STATE_DIR / "state.json")


def backup(name):
    BACKUP_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if shutil.disk_usage(BACKUP_DIR).free < 3 * 1024**3:
        raise RuntimeError(
            "Há menos de 3 GiB livres em disco. A atualização foi adiada."
        )
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    target = BACKUP_DIR / f"{name}-{stamp}.sql.gz"
    with tempfile.TemporaryFile(dir=BACKUP_DIR) as raw:
        run(
            [
                "docker",
                "exec",
                name,
                "sh",
                "-c",
                'export MYSQL_PWD="${MARIADB_ROOT_PASSWORD:-$MYSQL_ROOT_PASSWORD}"; '
                "exec mariadb-dump -uroot --all-databases --single-transaction "
                "--quick --routines --events --default-character-set=utf8mb4",
            ],
            timeout=180,
            output=raw,
        )
        size = raw.tell()
        raw.seek(max(0, size - 1024))
        if size < 100 or b"-- Dump completed on" not in raw.read():
            raise RuntimeError(
                "A cópia de segurança ficou incompleta. A atualização foi adiada."
            )
        raw.seek(0)
        with tempfile.NamedTemporaryFile(dir=BACKUP_DIR, delete=False) as compressed:
            temporary = Path(compressed.name)
            try:
                with gzip.GzipFile(fileobj=compressed, mode="wb") as stream:
                    shutil.copyfileobj(raw, stream)
            except BaseException:
                temporary.unlink(missing_ok=True)
                raise
        os.replace(temporary, target)
    return str(target)


def wait_ready(name):
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        try:
            run(
                [
                    "docker",
                    "exec",
                    name,
                    "sh",
                    "-c",
                    'export MYSQL_PWD="${MARIADB_ROOT_PASSWORD:-$MYSQL_ROOT_PASSWORD}"; '
                    "exec mariadb -uroot --batch --skip-column-names -e 'SELECT 1'",
                ],
                timeout=5,
            )
            return
        except (RuntimeError, subprocess.TimeoutExpired):
            time.sleep(2)
    raise RuntimeError(
        "A base de dados não respondeu à consulta de teste no prazo de dois minutos."
    )


def apply_database(name, record):
    path, version = DATABASES[name]
    candidate = record.get("candidate", "")
    if not re.fullmatch(
        r"mariadb:" + re.escape(version) + r"@sha256:[0-9a-f]{64}", candidate
    ):
        raise RuntimeError(
            "A atualização não pertence à série de versões configurada para esta base de dados."
        )
    # Always validate against the live model; never reuse secrets/configuration
    # saved by an earlier staging run.
    config = json.loads(
        run(
            ["docker", "compose", "-f", str(path), "config", "--format", "json"],
            cwd=path.parent,
        )
    )
    reference = config["services"][name]["image"]
    if reference != f"mariadb:{version}":
        raise RuntimeError(
            "A imagem configurada foi alterada. É necessário preparar a atualização novamente."
        )
    current = inspect(name)
    downloaded = inspect(candidate, image=True)
    if not current["State"]["Running"]:
        raise RuntimeError(
            "A base de dados já estava parada. A atualização foi adiada."
        )
    if current["Image"] == downloaded["Id"]:
        wait_ready(name)
        run(["docker", "image", "tag", candidate, reference])
        return current, None
    saved_backup = backup(name)
    record["pre_update_backup"] = saved_backup
    # A separate image-only override ensures no other staged service is applied.
    with tempfile.NamedTemporaryFile(
        mode="w", dir=STATE_DIR, suffix=".json"
    ) as override:
        json.dump({"services": {name: {"image": candidate}}}, override)
        override.flush()
        command = ["docker", "compose", "-f", str(path), "-f", override.name]
        run([*command, "config", "--quiet"], cwd=path.parent)
        if not shutting_down():
            raise RuntimeError(
                "O encerramento do servidor foi cancelado. A atualização foi adiada."
            )
        run(
            [
                *command,
                "up",
                "-d",
                "--no-deps",
                "--no-build",
                "--pull",
                "never",
                "--timeout",
                "120",
                name,
            ],
            cwd=path.parent,
            timeout=180,
        )
    updated = inspect(name)
    if updated["Image"] != downloaded["Id"]:
        raise RuntimeError("A base de dados não arrancou com a imagem descarregada.")
    wait_ready(name)
    # Normal compose up must also resolve the applied patch, rather than the
    # older mutable tag that staging deliberately preserved until shutdown.
    run(["docker", "image", "tag", candidate, reference])
    return updated, saved_backup


def notify(lines, errors):
    try:
        run(
            [
                "/usr/bin/python3",
                DM,
                "\n".join(lines),
                (
                    "⚠️ Não foi possível concluir a atualização das bases de dados"
                    if errors
                    else "✅ Bases de dados atualizadas"
                ),
            ],
            timeout=40,
        )
    except Exception:
        log(
            "Database update notification failed; results remain in state.json and the journal"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group(required=True)
    modes.add_argument(
        "--shutdown",
        action="store_true",
        help="Apply only while systemd is shutting down the host",
    )
    modes.add_argument(
        "--check",
        action="store_true",
        help="Show queued database updates without applying them",
    )
    args = parser.parse_args()
    if args.shutdown and not shutting_down():
        log("No host shutdown in progress; databases left running unchanged")
        return 0
    state_path = STATE_DIR / "state.json"
    if not state_path.exists():
        return 0
    with open(STATE_DIR / "lock", "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log("Staging is busy; database updates remain queued for the next shutdown")
            return 0
        state = json.loads(state_path.read_text())
        records = state.get("services", {})
        lines, errors = [], []
        for name in DATABASES:
            record = records.get(name, {})
            if not (record.get("pending") and record.get("downloaded")):
                continue
            if args.check:
                log(f"{name}: {record['candidate']}; queued for host shutdown/reboot")
                continue
            try:
                # Shutdown may have been cancelled since entering the hook.
                if not shutting_down():
                    log("Shutdown cancelled; remaining database updates deferred")
                    break
                updated, saved_backup = apply_database(name, record)
                record.update(
                    pending=False,
                    running=updated["Config"]["Image"],
                    running_image=updated["Image"],
                    applied_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                )
                if saved_backup:
                    record["pre_update_backup"] = saved_backup
                record.pop("apply_error", None)
                atomic_state(state)
                lines.append(
                    f"• **{name}** — atualização para a versão {record['version']} instalada e verificada (`{record['digest'][7:19]}`)."
                )
                log(f"{name}: database update applied and verified")
            except Exception as error:
                record["apply_error"] = str(error)
                atomic_state(state)
                errors.append(f"{name}: {error}")
                log(f"ERROR {errors[-1]}")
        if lines or errors:
            if errors:
                lines += [
                    "",
                    "**Não foi possível confirmar estas atualizações:**",
                    *["• " + error for error in errors],
                ]
            notify(lines, errors)
        return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
