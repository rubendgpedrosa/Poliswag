#ENVIRONMENT
ENV="DEVELOPMENT"  # Set to "PRODUCTION" for live deployment
#ENVIRONMENT

#API KEYS
DISCORD_API_KEY="YOUR_DISCORD_API_KEY"  # Your Discord bot token
AGENT_JOBS_DIR="logs/agent-jobs"  # Shared with the host-side Claude/Codex worker
#!API KEYS

#DISCORD CHANNELS
MOD_CHANNEL_ID="1234567890123456789"           # Moderator channel
ACCOUNTS_CHANNEL_ID="1234567890123456789"      # Account management channel
VOICE_CHANNEL_LEIRIA_ID="1234567890123456789"  # Voice channel for the combined STATUS label (Leiria+Marinha)
CONVIVIO_CHANNEL_ID="1234567890123456789"      # Community channel
QUEST_CHANNEL_ID="1234567890123456789"         # Quest notifications channel
#!DISCORD CHANNELS

#USER IDS
MY_ID="1234567890123456789"                # Your Discord user ID
ADMIN_USERS_IDS="12345,67890,12345"        # Comma-separated list of admin user IDs
#!USER IDS

#DATABASE
DB_HOST="db"
DB_PORT=3306
DB_SCANNER_NAME="DB_SCANNER"
DB_USER="DB_USER"
DB_PASSWORD="DB_PASSWORD"
DB_POLISWAG="DB_POLISWAG"
DB_DRAGONITE="dragonite"
DB_POGOLEIRIA="pogoleiria"   # landing app analytics, read-only (optional, this is the default)
#!DATABASE

#ENDPOINTS
NIANTIC_FORCED_VERSION_ENDPOINT="https://pgorelease.nianticlabs.com/plfe/version"
SCAN_QUESTS_ALL_ENDPOINT="http://127.0.0.1:80/quest/all/start"
SCANNER_STATUS_ENDPOINT="http://127.0.0.1:7272/status"
DEVICE_STATUS_ENDPOINT="http://rotom-ng:7072/api/status"
SCANNER_ACCOUNTS_STATUS_ENDPOINT="http://127.0.0.1:7272/accounts/stats"
# Optional levelling pool for the account card; leave unset to hide it.
SCANNER_LEVEL_ACCOUNTS_STATUS_ENDPOINT="http://dragonite-level:7272/accounts/stats"
LEVEL_DEVICE_STATUS_ENDPOINT="http://rotom-ng-level:7072/api/status"
MASTERFILE_ENDPOINT="https://raw.githubusercontent.com/WatWowMap/Masterfile-Generator/master/master-latest-react-map.json"
TRANSLATIONFILE_ENDPOINT="https://raw.githubusercontent.com/PokeMiners/pogo_assets/master/Texts/Latest%20APK/JSON/i18n_english.json"
ALL_DOWN_ENDPOINT="https://custom.duckdns.org/api/webhook/state"
OWNER_ALERT_ENDPOINT="https://custom.duckdns.org/api/webhook/poliswag_owner"
EVENTS_ENDPOINT="https://raw.githubusercontent.com/bigfoott/ScrapedDuck/data/events.min.json"
UI_ICONS_URL="https://raw.githubusercontent.com/nileplumb/PkmnShuffleMap/master/UICONS/"
QUEST_MAP_URL="https://tileserver.pogoleiria.pt"  # Rampardos; internal host URL also works
QUEST_MAP_STYLE="osm-bright"                    # Self-hosted Portugal dataset
#!ENDPOINTS

#PORACLE API
PORACLE_API_URL="http://poracle:3030"                # Internal Docker URL of the Poracle-NG container
PORACLE_API_SECRET=""                                 # Must match [processor] api_secret in poracleng/config/config.toml
#!PORACLE API

#FILES
LOG_FILE="/app/logs/actions.log"
ERROR_LOG_FILE="/app/logs/error.log"
POKEMON_NAME_FILE="/app/data/pokemon_name_map.json"
ITEM_NAME_FILE="/app/data/item_name_map.json"
TEMPLATE_HTML_DIR="/app/templates"
ACCOUNTS_TEMPLATE_HTML_FILE="accounts.html"
#!FILES

#FILES
SCANNER_CONTAINER_NAME="CONTAINER_NAME"
#!FILES

#ADB
ADB_DEVICE="192.168.1.222:5555"   # TCP/IP address of the Android device
#!ADB

#STACK_RECOVERY
UNOWNHASH_COMPOSE_FILE="/root/unonwhash/docker-compose.yml"  # scanner stack compose file (mounted read-only in prod)
RECREATE_SERVICES="dragonite rotom-ng"                        # services recreated when the map goes fully red
#!STACK_RECOVERY

#POLISNATCH
# Lure placement, !pn and shiny link resolution run through PoliSnatch's API.
# The base is per deployment and deliberately not committed; the submit key is
# minted there and read per call from the file below.
# POLISNATCH_JOBS_URL="https://CHANGE-ME/v1/jobs"
# POLISNATCH_JOBS_KEY_FILE="/etc/poliswag/secrets/polisnatch-jobs-key"
# POLISNATCH_JOBS_KEY=""   # inline fallback for the submit key; the file above is preferred
# POLISNATCH_STATUS_URL="https://CHANGE-ME/v1/game/status"   # polled every 5 min for a new game build (owner DM)
# POLISNATCH_UPDATE_STATE_FILE="state/polisnatch-update-state.json"  # which build/status was already told
#!POLISNATCH

# Names never allowed in a public reply, comma-separated. Deployment data:
# leave it empty here and set it in the host's .env.
# POLISWAG_PRIVATE_NAMES=""

#SHINY
# Spawn alerts and link-result DMs. false stops delivery only; channels,
# !shiny and the odds ticks keep running.
SHINY_ALERTS_ENABLED=true
# Opt-in event summaries; requires migration 034 before enabling.
SHINY_EVENT_DIGESTS_ENABLED=false
# Who gets shiny prediction DMs, comma-separated Discord ids; empty = the owner alone.
SHINY_ALERT_USER_IDS=
# Shiny leaderboard image (!shiny ranking).
SHINY_LEADERBOARD_ENABLED=false
#!SHINY

# Optional settings the code reads (defaults live in modules/config.py and the
# modules named). Leave unset to keep the default; never commit real values.

#OWNER CHATS (owner DMs only)
# HERMES_API_URL=""        # Hermes Runs API (CT 109)
# HERMES_API_KEY=""        # empty disables Hermes calls
# HERMES_SESSION_ID=""
# HERMES_RUNS_DIR="logs/hermes-runs"
# CLAUDE_API_URL=""        # claude-bridge (CT 109), "c " prefix
# CLAUDE_API_KEY=""
# CLAUDE_RUNS_DIR="logs/claude-runs"
# OWNER_DM_DEFAULT="hermes"  # who gets unprefixed owner DMs: hermes or claude; !usehermes/!useclaude rewrite it
# POLISWAG_ENV_FILE=".env"   # the file !usehermes/!useclaude rewrite and OWNER_DM_DEFAULT is read from
#!OWNER CHATS

#SORTEIO (!sorteio campfire reads the Campfire screenshots with the Messages API)
# ANTHROPIC_API_KEY=""     # empty disables the screenshot reading
# ANTHROPIC_WORKSPACE_ID=""
# CAMPFIRE_MODEL="claude-sonnet-5-5"
#!SORTEIO

#HERMISWAG (public agent, modules/hermiswag_client.py)
# HERMISWAG_API_URL=""     # empty: public tags use the agent worker only
# HERMISWAG_API_KEY=""
# HERMISWAG_SESSION_CHANNELS=""    # comma-separated conversation channel ids; learning keeps members' messages only
# HERMISWAG_LEARN_CHANNELS=""      # comma-separated channel ids it learns from; never moderation or alert channels
# HERMISWAG_PROACTIVE_CHANNELS=""  # comma-separated channel ids where it answers questions left unanswered for 10 min
# HERMISWAG_PROACTIVE_STATE="state/hermiswag-proactive.json"
# HERMISWAG_LEARNING_STATE="state/hermiswag-learning.json"
#!HERMISWAG

#MORE CHANNELS AND ROLES
# TRADES_CHANNEL_ID=""
# TRAP_CHANNEL_ID=""
# EVENT_PANEL_CHANNEL_ID=""
# EVENTS_ROLE_ID=""
#!MORE CHANNELS AND ROLES

